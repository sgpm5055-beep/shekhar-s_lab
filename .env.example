# Eligibility agent configuration. Everything below is commented out:
# copy to .env and uncomment what you need. With nothing set the service
# boots in degraded mode (stub SurePass, in-memory repo, no auth).

# SurePass is live iff this is EXACTLY the string "true"; anything else = stub.
# SUREPASS_LIVE=false
# SUREPASS_TOKEN=
# SUREPASS_BASE_URL=https://kyc-api.surepass.app

# Unset => API auth disabled (dev only). REQUIRED when REPO_BACKEND=supabase.
# SERVICE_API_TOKEN=

# HMAC-SHA256 key used to hash PAN + mobile into identity keys. Held outside
# the DB. ROTATING IT changes every hash: all three caches miss (results are
# re-bought), and locks, the per-PAN daily cap, report windows and the PAN-correction
# audit stop matching their old rows. PANs are not stored, so it cannot be re-keyed
# later - treat it as a long-lived secret.
# IDENTITY_HMAC_KEY=

# Persistence backend (memory is the default; supabase requires SERVICE_API_TOKEN).
# REPO_BACKEND=memory
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Private, encrypted Storage bucket for raw SurePass responses.
# RAW_BUCKET=raw-responses

# Checkpointer DSN. Use the Supabase SESSION pooler (:5432) or a direct
# connection - never the transaction pooler (:6543).
# DATABASE_URL=

# OpenAI (unset => the ranking model is unavailable)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# LangSmith tracing is on when this is exactly "true" OR LangChain's own env switches are
# (LANGCHAIN_TRACING_V2 / LANGSMITH_TRACING_V2 / LANGCHAIN_TRACING = "true"). Either way traces
# go through the app's payload-free tracer, and the app forces LANGSMITH_HIDE_INPUTS /
# LANGSMITH_HIDE_OUTPUTS to true at startup.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=eligibility-agent
# Recommended defence in depth, even though the app forces both at startup: they also cover any other process that
# builds a LangSmith client from the environment (a REPL, an eval run). Payloads never need to leave the process.
# Like LANGGRAPH_STRICT_MSGPACK, these are read from the process environment, not from this file: export them.
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# Where prompts are loaded from (default: local); PROMPT_TAG selects the prompt tag.
# PROMPT_SOURCE=local
# PROMPT_TAG=

# Overall graph run timeout, in seconds.
# GRAPH_TIMEOUT_SECONDS=90
# LOG_LEVEL=INFO

# Set in production: restricts checkpoint deserialization to known-safe types.
# LANGGRAPH_STRICT_MSGPACK=true

# NOTE: per-call timeouts (PAN 8s / Score 12s / Report 20s / OpenAI 8s) are
# fixed code constants and deliberately NOT configurable here.
